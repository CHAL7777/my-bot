# Telegram Quiz Bot - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================================================
# REQUIRED VARIABLES
# ============================================================================

# Telegram Bot Token from @BotFather
# Get it at: https://t.me/BotFather
BOT_TOKEN=your_bot_token_here

# Webhook URL - Your public HTTPS URL
# For Koyeb: https://your-app-name.koyeb.app
# Format: https://your-domain.com (without trailing slash)
WEBHOOK_URL=https://your-bot-url.koyeb.app

# ============================================================================
# OPTIONAL VARIABLES
# ============================================================================

# Port for the web server (Koyeb uses 10000 by default)
PORT=10000

# Database Configuration
# Options: sqlite, mysql, mariadb
DB_TYPE=sqlite

# Directory for persistent data (Koyeb provides /data)
DATA_DIR=/data

# SQLite database path
SQLITE_DB_PATH=/data/quizbot.db

# PostgreSQL/MySQL Configuration (if using DB_TYPE=mysql/mariadb)
# DB_HOST=your-database-host.com
# DB_PORT=5432
# DB_NAME=your_database_name
# DB_USER=your_username
# DB_PASSWORD=your_password

# Redis URL for session storage (optional, for horizontal scaling)
# REDIS_URL=redis://localhost:6379

# Admin Telegram IDs (comma-separated, no spaces)
# Get your ID at: @userinfobot
ADMIN_IDS=123456789,987654321

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable trial period for new users (true/false)
ENABLE_TRIAL=false

# Trial duration in days
TRIAL_DAYS=7

# ============================================================================
# PAYMENT CONFIGURATION
# ============================================================================

# Subscription prices in Ethiopian Birr (ETB)
SUBSCRIPTION_PRICE_30_DAYS=500
SUBSCRIPTION_PRICE_90_DAYS=1200
ONE_TIME_PRICE=150

# Currency settings
CURRENCY=ETB
CURRENCY_SYMBOL=ETB

# ============================================================================
# QUIZ LIMITS
# ============================================================================

# Maximum quizzes per user per day
DAILY_QUIZ_LIMIT=20

# Questions per quiz session
MAX_QUESTIONS_PER_QUIZ=10

# Global daily question limit (across all chapters and levels)
DAILY_QUESTION_LIMIT=500

# ============================================================================
# REFERRAL SYSTEM
# ============================================================================

# Number of referrals needed to trigger reward
REFERRAL_REWARD_THRESHOLD=5

# Reward type: premium, premium_days
REFERRAL_REWARD_TYPE=premium

# Days of premium for referral reward
REFERRAL_REWARD_DAYS=30

# Bot username (without @) for referral links
# Set this to match your bot's username on Telegram
BOT_USERNAME=SmartITestExambot

# ============================================================================
# SECURITY
# ============================================================================

# Encryption key for sensitive data (generate a random string)
# ENCRYPTION_KEY=your_encryption_key_here

# API rate limit per minute
API_RATE_LIMIT=100

# ============================================================================
# WEBHOOK SECURITY (Optional)
# ============================================================================

# Secret token for webhook verification
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# TELEGRAM_SECRET_TOKEN=your_secret_token_here

# ============================================================================
# KOYEB SPECIFIC
# ============================================================================

# Koyeb Health Check Endpoint
# HEALTH_CHECK_PATH=/ping

# ============================================================================
# DEBUG / DEVELOPMENT
# ============================================================================

# Enable debug mode (true/false)
# DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ============================================================================
# EXAMPLE .ENV FILE
# ============================================================================
#
# Here's a complete example for production deployment:
#
# BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# WEBHOOK_URL=https://my-quiz-bot.koyeb.app
# PORT=10000
# DB_TYPE=sqlite
# DATA_DIR=/data
# ADMIN_IDS=123456789
# ENABLE_TRIAL=false
# SUBSCRIPTION_PRICE_30_DAYS=500
# SUBSCRIPTION_PRICE_90_DAYS=1200
# ONE_TIME_PRICE=150
# DAILY_QUIZ_LIMIT=20
# MAX_QUESTIONS_PER_QUIZ=10
# DAILY_QUESTION_LIMIT=500
# REFERRAL_REWARD_THRESHOLD=5
# REFERRAL_REWARD_TYPE=premium
# REFERRAL_REWARD_DAYS=30
# BOT_USERNAME=MyQuizBot
#
# ============================================================================
# NOTES
# ============================================================================
#
# 1. NEVER commit this file to version control!
# 2. Add .env to your .gitignore file
# 3. Use Koyeb's Secrets feature for production deployment
# 4. Keep BOT_TOKEN secure - it provides full bot access
#
# ============================================================================

